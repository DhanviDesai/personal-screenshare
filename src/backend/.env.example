# LiveKit credentials (required) — never commit a real .env file
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# Optional — comma-separated CORS allow-list (or * for any origin)
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,https://dev-api.swedishchampionship.com
TOKEN_TTL_SECONDS=3600
